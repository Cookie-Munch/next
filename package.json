{
  "name": "@cookiemunch/next",
  "version": "0.1.0",
  "description": "Cookie Munch for the Next.js App Router: the tag, the Content-Security-Policy, and the React hooks",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && tsc -p tsconfig.json --emitDeclarationOnly --declaration",
    "test": "vitest run"
  },
  "dependencies": {
    "@cookiemunch/react": "^0.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cookie-Munch/next.git"
  },
  "homepage": "https://cookiemunch.net/docs/nextjs",
  "bugs": {
    "url": "https://github.com/Cookie-Munch/next/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
